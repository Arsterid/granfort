DOMAIN=example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=granfort
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_DB=granfort

DATABASE_URL=postgresql://granfort:replace_with_random_hex_password@db:5432/granfort?schema=public

AUTH_SECRET=replace_with_random_secret
AUTH_URL=https://example.com
NEXTAUTH_URL=https://example.com
AUTH_TRUST_HOST=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_at_least_16_characters
ADMIN_NAME=GRANFORT Administrator

UPLOAD_DIR=/var/lib/granfort/uploads
