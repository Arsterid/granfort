generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  name         String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique(map: "product_slug_key")
  sku         String? @unique(map: "product_sku_key")
  description String? @db.Text

  status    ProductStatus @default(DRAFT)
  sortOrder Int           @default(0)

  vehicles ProductVehicle[]
  images   ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

model VehicleBrand {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique(map: "vehicle_brand_name_key")
  slug String @unique(map: "vehicle_brand_slug_key")

  models VehicleModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleModel {
  id      String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  name    String
  slug    String

  brand    VehicleBrand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants VehicleVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, name], map: "vehicle_model_brand_id_name_key")
  @@unique([brandId, slug], map: "vehicle_model_brand_id_slug_key")
}

model VehicleVariant {
  id             String @id @default(uuid()) @db.Uuid
  vehicleModelId String @db.Uuid

  generation String?
  yearFrom   Int?
  yearTo     Int?
  trim       String?
  notes      String? @db.Text

  vehicleModel VehicleModel     @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  products     ProductVehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleModelId, generation])
  @@index([vehicleModelId, trim])
}

model ProductVehicle {
  productId        String  @db.Uuid
  vehicleVariantId String  @db.Uuid
  fitmentNotes     String? @db.Text

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Restrict)

  @@id([productId, vehicleVariantId])
  @@index([vehicleVariantId, productId])
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  storageKey String  @unique
  altText    String?
  sortOrder  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}
